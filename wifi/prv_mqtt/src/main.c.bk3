#include <zephyr/net/mqtt.h> #include <zephyr/net/socket.h> #include <zephyr/net/net_mgmt.h> #include <zephyr/net/wifi_mgmt.h> #include <zephyr/logging/log.h> #include <string.h> LOG_MODULE_REGISTER(app, LOG_LEVEL_INF); /* ---------------- Wi-Fi / MQTT Settings ---------------- */ #define WIFI_SSID "Utsav" #define WIFI_PASSWORD "utsav12345" #define MQTT_BROKER_HOST "utsavmqtt.in" #define MQTT_BROKER_PORT 1883 #define MQTT_CLIENT_ID "zephyr_client" #define MQTT_TOPIC "test" static struct mqtt_client client; static struct sockaddr_storage broker; static uint8_t rx_buffer[512]; static uint8_t tx_buffer[512]; static uint8_t payload[] = "hello from Zephyr"; static volatile bool got_connack = false; static struct net_mgmt_event_callback wifi_cb; static struct k_sem wifi_connected; /* ---------------- Wi-Fi Handler ---------------- */ static void wifi_event_handler(struct net_mgmt_event_callback *cb, uint64_t mgmt_event, struct net_if *iface) { ARG_UNUSED(cb); ARG_UNUSED(iface); if (mgmt_event == NET_EVENT_WIFI_CONNECT_RESULT) { LOG_INF("Wi-Fi connected"); k_sem_give(&wifi_connected); } else if (mgmt_event == NET_EVENT_WIFI_DISCONNECT_RESULT) { LOG_WRN("Wi-Fi disconnected"); } } /* ---------------- DNS Resolver ---------------- */ static int resolve_broker(const char *host, uint16_t port, struct sockaddr_storage *broker) { struct zsock_addrinfo hints = { .ai_family = AF_INET, .ai_socktype = SOCK_STREAM }; struct zsock_addrinfo *res = NULL; int rc = zsock_getaddrinfo(host, NULL, &hints, &res); if (rc) { LOG_ERR("DNS lookup failed for %s (%d)", host, rc); return rc; } struct sockaddr_in *broker4 = (struct sockaddr_in *)res->ai_addr; broker4->sin_port = htons(port); memcpy(broker, broker4, sizeof(struct sockaddr_in)); zsock_freeaddrinfo(res); return 0; } /* ---------------- Wi-Fi Connect ---------------- */ static int connect_wifi(void) { int rc; struct net_if *iface = net_if_get_default(); net_mgmt_init_event_callback(&wifi_cb, wifi_event_handler, NET_EVENT_WIFI_CONNECT_RESULT | NET_EVENT_WIFI_DISCONNECT_RESULT); net_mgmt_add_event_callback(&wifi_cb); struct wifi_connect_req_params cnx = { .ssid = WIFI_SSID, .ssid_length = strlen(WIFI_SSID), .psk = WIFI_PASSWORD, .psk_length = strlen(WIFI_PASSWORD), .security = WIFI_SECURITY_TYPE_PSK, .channel = WIFI_CHANNEL_ANY, .timeout = SYS_FOREVER_MS }; LOG_INF("Connecting to Wi-Fi SSID: %s ...", WIFI_SSID); k_sem_init(&wifi_connected, 0, 1); rc = net_mgmt(NET_REQUEST_WIFI_CONNECT, iface, &cnx, sizeof(cnx)); if (rc) { LOG_ERR("Wi-Fi connect request failed (%d)", rc); return -1; } if (k_sem_take(&wifi_connected, K_SECONDS(15)) != 0) { LOG_ERR("Wi-Fi connection timeout"); return -1; } return 0; } static void mqtt_evt_handler(struct mqtt_client *const c, const struct mqtt_evt *evt) { switch (evt->type) { case MQTT_EVT_CONNACK: if (evt->result == 0) { got_connack = true; LOG_INF("MQTT connected (CONNACK)."); } else { LOG_ERR("MQTT CONNACK error: %d", evt->result); } break; case MQTT_EVT_DISCONNECT: LOG_WRN("MQTT disconnected"); break; case MQTT_EVT_PUBACK: LOG_INF("PUBACK received for message id %u", evt->param.puback.message_id); break; default: break; } } /* ---------------- MQTT Loop ---------------- */ static void mqtt_main_loop(struct mqtt_client *c) { struct mqtt_publish_param pub; int rc; while (1) { /* Process incoming packets & send keep-alive */ mqtt_input(c); mqtt_live(c); /* Prepare and publish message */ pub.message.topic.qos = MQTT_QOS_0_AT_MOST_ONCE; pub.message.topic.topic.utf8 = (uint8_t *)MQTT_TOPIC; pub.message.topic.topic.size = strlen(MQTT_TOPIC); pub.message.payload.data = payload; pub.message.payload.len = strlen(payload); pub.message_id = 1U; pub.dup_flag = 0U; pub.retain_flag = 0U; rc = mqtt_publish(c, &pub); LOG_INF("Publish result: %d", rc); k_sleep(K_SECONDS(10)); } } /* ---------------- Main ---------------- */ int main(void) { int rc; rc = connect_wifi(); if (rc) return rc; rc = resolve_broker(MQTT_BROKER_HOST, MQTT_BROKER_PORT, &broker); if (rc) return rc; struct mqtt_client *c = &client; mqtt_client_init(c); c->clean_session = 1; /* must be right after init */ LOG_INF("MQTT clean_session=%d (expect 1)", c->clean_session); c->broker = &broker; c->evt_cb = mqtt_evt_handler; c->client_id.utf8 = (uint8_t *)MQTT_CLIENT_ID; c->client_id.size = strlen(MQTT_CLIENT_ID); //c->password->utf8 =(uint8_t *)"pass"; //c->password->size =strlen("pass"); //c->user_name->utf8 = (uint8_t*)"usy"; //c->user_name->size = strlen("usy"); c->password=NULL; c->user_name=NULL; c->protocol_version = MQTT_VERSION_3_1_1; c->transport.type = MQTT_TRANSPORT_NON_SECURE; c->rx_buf = rx_buffer; c->rx_buf_size = sizeof(rx_buffer); c->tx_buf = tx_buffer; c->tx_buf_size = sizeof(tx_buffer); LOG_INF("Connecting to MQTT broker: %s:%d", MQTT_BROKER_HOST, MQTT_BROKER_PORT); k_msleep(2000); rc = mqtt_connect(c); if (rc) { LOG_ERR("mqtt_connect failed: %d", rc); return rc; } /* Allow some time for CONNACK */ // for (int i = 0; i < 10; i++) { // mqtt_input(c); // mqtt_live(c); // k_sleep(K_MSEC(100)); // } // LOG_INF("MQTT connection established, starting main loop..."); // mqtt_main_loop(c); int wait_ms = 0; while (!got_connack && wait_ms < 3000) { /* up to ~3s */ mqtt_input(c); mqtt_live(c); k_sleep(K_MSEC(50)); wait_ms += 50; } if (!got_connack) { LOG_ERR("No CONNACK within timeout, aborting."); return -EIO; } while (1) { mqtt_input(c); mqtt_live(c); struct mqtt_publish_param pub = {0}; pub.message.topic.qos = MQTT_QOS_0_AT_MOST_ONCE; pub.message.topic.topic.utf8 = (uint8_t *)MQTT_TOPIC; pub.message.topic.topic.size = strlen(MQTT_TOPIC); pub.message.payload.data = payload; pub.message.payload.len = strlen(payload); int rc = mqtt_publish(c, &pub); LOG_INF("Publish result: %d", rc); k_sleep(K_SECONDS(10)); } return 0; }
